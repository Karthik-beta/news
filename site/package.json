{
  "name": "@news/site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "sync-tokens": "bun scripts/sync-tokens.ts",
    "predev": "bun scripts/sync-tokens.ts",
    "dev": "bun --bun astro dev --host 127.0.0.1",
    "prebuild": "bun scripts/sync-tokens.ts",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview --host 127.0.0.1",
    "typecheck": "bun --bun astro check",
    "pretest": "bun scripts/sync-tokens.ts",
    "test": "vitest run --project unit --project component --project astro",
    "test:watch": "vitest --project unit --project component --project astro",
    "test:integration": "bun run build && vitest run --project integration",
    "test:e2e": "playwright test --project='smoke-*'",
    "test:e2e:full": "playwright test --project='chromium-*' --project='firefox-*' --project='webkit-*'",
    "test:visual": "bun scripts/visual.ts",
    "test:visual:update": "bun scripts/visual.ts --update-snapshots",
    "sync-fonts": "bun scripts/sync-fonts.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@openuidev/react-headless": "0.18.8",
    "@openuidev/react-lang": "1.1.1",
    "@openuidev/react-ui": "0.18.8",
    "astro": "^7.4.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "html-validate": "^11.21.1",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
