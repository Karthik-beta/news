{
  // The `site` Worker (ADR 0010): server-renders every page that lists pages (home, region views, hubs, "Latest")
  // and serves the shell assets. Article paths (/2*) never reach it: the zone routes (#21) send them to R2.
  // Built by `astro build` through @astrojs/cloudflare; `bun run dev` selects the "local" environment.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "news-site",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  // Our own structured logs only: invocation logs record client IPs, which these Workers never keep (ADR 0006).
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "vars": {
    "NEWS_ENV": "production",
    "NEWS_DATA": "dynamodb",
    // bun run validate fails if these two differ from workers/api/wrangler.jsonc.
    "NEWS_SITE_ORIGIN": "https://news.karthik.nz",
    "NEWS_REGION_VIEWS": "north-america,europe,india,china,asia,australia,global"
  },
  // 30 requests a minute per IP (per location) on search and on cache misses of 404, cursor and filter requests.
  "ratelimits": [{ "name": "SEARCH_RATE_LIMITER", "namespace_id": "1301", "simple": { "limit": 30, "period": 60 } }],
  "env": {
    // `CLOUDFLARE_ENV=local`: dev and tests. The data is the fixture set in the isolate's memory; refused in production.
    "local": {
      "vars": {
        "NEWS_ENV": "local",
        "NEWS_DATA": "local",
        "NEWS_SITE_ORIGIN": "https://news.karthik.nz",
        "NEWS_REGION_VIEWS": "north-america,europe,india,china,asia,australia,global"
      },
      "ratelimits": [{ "name": "SEARCH_RATE_LIMITER", "namespace_id": "1301", "simple": { "limit": 30, "period": 60 } }]
    }
  }

  // TODO(Karthik, Phase 6 provisioning, #21): declare the real bindings here once the resources exist.
  // "vars": add "NEWS_DYNAMODB_TABLE": "<table>", "NEWS_DYNAMODB_REGION": "<region>"
  // "r2_buckets": [{ "binding": "PAGES", "bucket_name": "<real R2 bucket>" }],
  // "d1_databases": the same SEARCH_<YYYY> shards as the api Worker (this Worker only runs SELECTs on them), one per year:
  //   [{ "binding": "SEARCH_2026", "database_name": "news-search-2026", "database_id": "<real D1 id>" }],
  // Secrets, set with `wrangler secret put`, never in this file: NEWS_DYNAMODB_ACCESS_KEY_ID and
  // NEWS_DYNAMODB_SECRET_ACCESS_KEY of a READ-ONLY IAM key: GetItem, BatchGetItem and Query on the one table, with
  // dynamodb:LeadingKeys limited to PAGE#*, HUB#*, ENT#*, TAX#tree, URL#* and HOME#CURATION (workers/README.md).
}
