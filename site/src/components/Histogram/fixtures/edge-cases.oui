root = Page([signs, money, large, single, unknown])
signs = Histogram("A fall is never crimson", "Synthetic values, %", [{label: "A fall", value: "dp_fx_bar_negative", highlight: true}, {label: "No change", value: "dp_fx_bar_zero"}, {label: "A rise", value: "dp_fx_bar_positive"}, {label: "Very large", value: "dp_fx_bar_large"}, {label: "Very small", value: "dp_fx_bar_small"}, {label: "Not published", value: "dp_fx_bar_null"}, {label: "Different unit", value: "dp_fx_bar_usd"}])
money = Histogram("Most of Apple's regions sold less than $50bn a year", "Net sales by region, fiscal 2023 and 2024, US$ bn", [{label: "Americas, {pd_fy2023}", value: "dp_aapl_sales_americas_fy2023"}, {label: "Americas, {pd_fy2024}", value: "dp_aapl_sales_americas_fy2024"}, {label: "Europe, {pd_fy2023}", value: "dp_aapl_sales_europe_fy2023"}, {label: "Europe, {pd_fy2024}", value: "dp_aapl_sales_europe_fy2024"}, {label: "Greater China, {pd_fy2023}", value: "dp_aapl_sales_china_fy2023"}, {label: "Greater China, {pd_fy2024}", value: "dp_aapl_sales_china_fy2024"}, {label: "Japan, {pd_fy2023}", value: "dp_aapl_sales_japan_fy2023"}, {label: "Japan, {pd_fy2024}", value: "dp_aapl_sales_japan_fy2024"}, {label: "Rest of Asia Pacific, {pd_fy2023}", value: "dp_aapl_sales_rapac_fy2023"}, {label: "Rest of Asia Pacific, {pd_fy2024}", value: "dp_aapl_sales_rapac_fy2024"}])
large = Histogram("Very large values keep every digit", "Synthetic amounts, US$", [{label: "Year one", value: "dp_fx_large_2019"}, {label: "Year two", value: "dp_fx_large_2020"}, {label: "Year three", value: "dp_fx_large_2021"}, {label: "Year four", value: "dp_fx_large_2022"}, {label: "Year five", value: "dp_fx_large_2023"}, {label: "Year six", value: "dp_fx_large_2024"}])
single = Histogram("One value", "Turnout, %", [{label: "Turnout", value: "dp_fx_single_2024"}, {label: "Not published", value: "dp_fx_bar_null"}])
unknown = Histogram("Every value unknown", "Nothing to plot", [{label: "Unknown", value: "dp_fx_bar_not_in_data"}, {label: "Also unknown", value: "dp_fx_bar_nothing_here"}])
