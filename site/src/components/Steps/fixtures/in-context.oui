root = Page([intro, card, lead, how, after, cpi, outro])
intro = Prose(["The Federal Reserve cut its target range again at the meeting that ended on {pd_fomc_20241218}. The statement it published that day is the document this page rests on."])
card = SourceCard("src_fomc_statement_dec_2024")
lead = Prose(["## How a rate decision is made", "Each decision follows the same few steps."])
how = Steps([{title: "The committee meets", text: "The Federal Open Market Committee meets several times a year; its last meeting of the year ended on {pd_fomc_20241218}."}, {title: "It votes on a target range", text: "The vote in December was {cx_fomc_vote_20241218}, and the upper limit moved to {dp_fed_upper_20241218}."}, {title: "Markets move to the new range", text: "Banks then lend to each other overnight inside the new range, which moves in [basis points](glossary:basis-point)."}])
after = Prose(["## What inflation did", "Consumer prices rose more slowly through the year."])
cpi = LineChart("Inflation in America eased through the year", "Consumer prices, change on a year earlier, 2024, %", ["sr_us_cpi_2024"], "sr_us_cpi_2024", null, false, [{at: "pd_2024_03", text: "Spring"}, {at: "pd_2024_09", text: "First rate cut"}, {at: "pd_2024_12", text: "Year end"}])
outro = Prose(["The committee meets again in the new year."])
