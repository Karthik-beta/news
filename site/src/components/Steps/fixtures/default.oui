root = Page([how])
how = Steps([{title: "The committee meets", text: "The Federal Open Market Committee meets several times a year; its last meeting of the year ended on {pd_fomc_20241218}."}, {title: "It votes on a target range", text: "The vote in December was {cx_fomc_vote_20241218}, and the upper limit moved to {dp_fed_upper_20241218}."}, {title: "It publishes a statement", text: "The statement gives the reasons: {q_fomc_statement_sep_2024}"}, {title: "Markets move to the new range", text: "Banks then lend to each other overnight inside the new range, which moves in [basis points](glossary:basis-point)."}])
