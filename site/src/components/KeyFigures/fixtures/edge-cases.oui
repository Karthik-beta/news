root = Page([missing, sizes, mixed, rates])
missing = KeyFigures([zero, negative, unpublished, unknown])
zero = KeyFigure("Zero", "dp_edge_zero")
negative = KeyFigure("Negative, with a fall", "dp_edge_negative", "dv_edge_change_neg", "pd_edge_2022")
unpublished = KeyFigure("Not published", "dp_edge_null")
unknown = KeyFigure("Unknown reference", "dp_edge_not_in_data", "dv_edge_not_in_data", "pd_edge_2022", "sr_edge_not_in_data")
sizes = KeyFigures([large, small])
large = KeyFigure("Very large", "dp_edge_very_large", null, null, "sr_fx_large")
small = KeyFigure("Very small", "dp_edge_very_small", null, null, "sr_fx_small")
mixed = KeyFigures([single, gaps, allnull])
single = KeyFigure("A trend of one point", "dp_fx_single_2024", null, null, "sr_fx_single")
gaps = KeyFigure("A trend with gaps", "dp_fx_gaps_2024", null, null, "sr_fx_gaps")
allnull = KeyFigure("A trend with no values", "dp_edge_percent", null, null, "sr_fx_allnull")
rates = KeyFigures([peak, latest])
peak = KeyFigure("Federal funds rate at its peak, upper limit", "dp_fed_upper_20230726")
latest = KeyFigure("Federal funds rate after December 2024, upper limit", "dp_fed_upper_20241218")
