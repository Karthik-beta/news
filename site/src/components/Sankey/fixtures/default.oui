root = Page([flows])
flows = Sankey("About a quarter of Apple's sales became net income in {pd_fy2024}", "From net sales to net income, fiscal 2024, US$ bn", [{label: "Total net sales", value: "dp_aapl_net_sales_fy2024", kind: "total"}, {label: "Total cost of sales", value: "dp_aapl_cost_of_sales_fy2024", kind: "deduct"}, {label: "Gross margin", value: "dp_aapl_gross_margin_fy2024", kind: "total"}, {label: "Research and development", value: "dp_aapl_rnd_fy2024", kind: "deduct"}, {label: "Selling, general and administrative", value: "dp_aapl_sga_fy2024", kind: "deduct"}, {label: "Operating income", value: "dp_aapl_operating_income_fy2024", kind: "total"}, {label: "Other income/(expense), net", value: "dp_aapl_other_income_fy2024", kind: "add"}, {label: "Provision for income taxes", value: "dp_aapl_tax_fy2024", kind: "deduct"}, {label: "Net income", value: "dp_aapl_net_income_fy2024", kind: "total"}], [{label: "iPhone", value: "dp_aapl_sales_iphone_fy2024"}, {label: "Mac", value: "dp_aapl_sales_mac_fy2024"}, {label: "iPad", value: "dp_aapl_sales_ipad_fy2024"}, {label: "Wearables, Home and Accessories", value: "dp_aapl_sales_wearables_fy2024"}, {label: "Services", value: "dp_aapl_sales_services_fy2024"}])
