root = Page([fold, nosegments, loss, mismatch, unknown])
fold = Sankey("Small segments and costs fold into Other", "Synthetic income statement, US$ m", [{label: "Revenue", value: "dp_fx_sk_revenue", kind: "total"}, {label: "Cost of revenue", value: "dp_fx_sk_cost", kind: "deduct"}, {label: "Gross profit", value: "dp_fx_sk_gross", kind: "total"}, {label: "Operating expenses", value: "dp_fx_sk_opex", kind: "deduct"}, {label: "Impairment", value: "dp_fx_sk_small_1", kind: "deduct"}, {label: "Litigation", value: "dp_fx_sk_small_2", kind: "deduct"}, {label: "Operating profit", value: "dp_fx_sk_operating", kind: "total"}, {label: "Tax", value: "dp_fx_sk_tax", kind: "deduct"}, {label: "Net profit", value: "dp_fx_sk_net", kind: "total"}], [{label: "Segment A", value: "dp_fx_sk_seg_a"}, {label: "Segment B", value: "dp_fx_sk_seg_b"}, {label: "Segment C", value: "dp_fx_sk_seg_c"}, {label: "Segment D", value: "dp_fx_sk_seg_d"}, {label: "Segment E", value: "dp_fx_sk_seg_e"}, {label: "Segment F", value: "dp_fx_sk_seg_f"}, {label: "Segment G", value: "dp_fx_sk_seg_g"}])
nosegments = Sankey("Without segments the flows start at net sales", "Net sales to operating income, fiscal 2024, US$ bn", [{label: "Total net sales", value: "dp_aapl_net_sales_fy2024", kind: "total"}, {label: "Total cost of sales", value: "dp_aapl_cost_of_sales_fy2024", kind: "deduct"}, {label: "Gross margin", value: "dp_aapl_gross_margin_fy2024", kind: "total"}, {label: "Research and development", value: "dp_aapl_rnd_fy2024", kind: "deduct"}, {label: "Selling, general and administrative", value: "dp_aapl_sga_fy2024", kind: "deduct"}, {label: "Operating income", value: "dp_aapl_operating_income_fy2024", kind: "total"}])
loss = Sankey("A loss cannot flow, so the waterfall shows at every width", "Synthetic income statement, US$ m", [{label: "Revenue", value: "dp_fx_wf_revenue", kind: "total"}, {label: "Cost of revenue", value: "dp_fx_wf_cost", kind: "deduct"}, {label: "Gross profit", value: "dp_fx_wf_gross", kind: "total"}, {label: "Operating expenses", value: "dp_fx_wf_opex", kind: "deduct"}, {label: "Operating loss", value: "dp_fx_wf_operating", kind: "total"}, {label: "Income tax", value: "dp_fx_wf_tax", kind: "deduct"}, {label: "Net loss", value: "dp_fx_wf_net", kind: "total"}])
mismatch = Sankey("Lines that do not add up are shown as a waterfall with a note", "Net sales to operating income, fiscal 2024, US$ bn", [{label: "Total net sales", value: "dp_aapl_net_sales_fy2024", kind: "total"}, {label: "Total cost of sales", value: "dp_aapl_cost_of_sales_fy2024", kind: "deduct"}, {label: "Gross margin", value: "dp_aapl_gross_margin_fy2024", kind: "total"}, {label: "Research and development", value: "dp_aapl_rnd_fy2024", kind: "deduct"}, {label: "Operating income", value: "dp_aapl_operating_income_fy2024", kind: "total"}])
unknown = Sankey("Every line unknown", "Nothing to plot", [{label: "Revenue", value: "dp_fx_sk_not_in_data", kind: "total"}, {label: "Cost", value: "dp_fx_sk_not_in_data_either", kind: "deduct"}])
