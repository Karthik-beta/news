root = Page([years, fell, unknown, otherunit])
years = StackedBar("Missing, zero and negative parts across six years", "Synthetic shares, %", ["Other", "Third", "Gaps", "Zero line"], [{label: "{pd_fx_2019}", values: ["dp_fx_other_2019", "dp_fx_third_2019", "dp_fx_gaps_2019", "dp_fx_zero_2019"]}, {label: "{pd_fx_2020}", values: ["dp_fx_other_2020", "dp_fx_third_2020", "dp_fx_gaps_not_in_data", "dp_fx_zero_2020"]}, {label: "{pd_fx_2021}", values: ["dp_fx_other_2021", "dp_fx_third_2021", "dp_fx_gaps_2021", "dp_fx_zero_2021"]}, {label: "{pd_fx_2022}", values: ["dp_fx_other_2022", "dp_fx_third_2022", "dp_fx_gaps_2022", "dp_fx_zero_2022"]}, {label: "A row label long enough to wrap on a phone, with every part missing", values: ["dp_fx_allnull_2019", "dp_fx_allnull_2020", "dp_fx_allnull_2022", "dp_fx_allnull_2023"]}, {label: "{pd_fx_2024}", values: ["dp_fx_other_2024", "dp_fx_third_2024", "dp_fx_gaps_2024", "dp_fx_zero_2024"]}])
fell = StackedBar("Greater China's sales fell, so its part is never crimson", "Net sales by region, fiscal years, US$ bn", ["Americas", "Europe", "Greater China"], [{label: "{pd_fy2023}", values: ["dp_aapl_sales_americas_fy2023", "dp_aapl_sales_europe_fy2023", "dp_aapl_sales_china_fy2023"]}, {label: "{pd_fy2024}", values: ["dp_aapl_sales_americas_fy2024", "dp_aapl_sales_europe_fy2024", "dp_aapl_sales_china_fy2024"]}], "Greater China")
unknown = StackedBar("Every part unknown", "Nothing to plot", ["One", "Two"], [{label: "Row", values: ["dp_fx_bar_not_in_data", "dp_fx_bar_not_in_data_either"]}])
otherunit = StackedBar("A part in another unit is left out, never converted", "Synthetic values, %", ["Percent", "Dollars"], [{label: "Row", values: ["dp_fx_bar_positive", "dp_fx_bar_usd"]}])
