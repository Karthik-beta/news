root = Page([dumbbell, dots])
dumbbell = DotPlot("Sales rose in every region but Greater China", "Net sales by region, fiscal years, US$ bn", [{label: "Americas", values: ["dp_aapl_sales_americas_fy2023", "dp_aapl_sales_americas_fy2024"]}, {label: "Europe", values: ["dp_aapl_sales_europe_fy2023", "dp_aapl_sales_europe_fy2024"], highlight: true}, {label: "Greater China", values: ["dp_aapl_sales_china_fy2023", "dp_aapl_sales_china_fy2024"]}, {label: "Japan", values: ["dp_aapl_sales_japan_fy2023", "dp_aapl_sales_japan_fy2024"]}, {label: "Rest of Asia Pacific", values: ["dp_aapl_sales_rapac_fy2023", "dp_aapl_sales_rapac_fy2024"]}], ["{pd_fy2023}", "{pd_fy2024}"])
dots = DotPlot("Services earns the highest gross margin", "Gross margin as a share of net sales, fiscal 2024, %", [{label: "Services", values: ["dp_aapl_gm_services_fy2024"], highlight: true}, {label: "Products", values: ["dp_aapl_gm_products_fy2024"]}])
