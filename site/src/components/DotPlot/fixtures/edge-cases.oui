root = Page([fell, gaps, signs, single, unknown])
fell = DotPlot("Greater China was the only region where sales fell", "Net sales by region, fiscal years, US$ bn", [{label: "Americas", values: ["dp_aapl_sales_americas_fy2023", "dp_aapl_sales_americas_fy2024"]}, {label: "Greater China", values: ["dp_aapl_sales_china_fy2023", "dp_aapl_sales_china_fy2024"], highlight: true}, {label: "Japan", values: ["dp_aapl_sales_japan_fy2023", "dp_aapl_sales_japan_fy2024"]}], ["{pd_fy2023}", "{pd_fy2024}"], "given")
gaps = DotPlot("A missing value is No data, never a zero", "Synthetic values, %", [{label: "Both present", values: ["dp_fx_gaps_2019", "dp_fx_gaps_2021"]}, {label: "Second not published", values: ["dp_fx_gaps_2021", "dp_fx_gaps_2022"]}, {label: "First unknown", values: ["dp_fx_gaps_not_in_data", "dp_fx_gaps_2024"]}, {label: "Equal values", values: ["dp_fx_gaps_2024", "dp_fx_gaps_2024"]}, {label: "A long label that has to wrap on a phone, with a fall", values: ["dp_fx_gaps_2021", "dp_fx_gaps_2023"]}], ["Earlier", "Later"], "given")
signs = DotPlot("Negative, zero and positive values on one scale", "Synthetic values, %", [{label: "A fall", values: ["dp_fx_bar_negative"], highlight: true}, {label: "No change", values: ["dp_fx_bar_zero"]}, {label: "A rise", values: ["dp_fx_bar_positive"]}, {label: "Different unit", values: ["dp_fx_bar_usd"]}])
single = DotPlot("One dot", "Turnout, %", [{label: "Turnout", values: ["dp_fx_single_2024"]}])
unknown = DotPlot("Every value unknown", "Nothing to plot", [{label: "Unknown", values: ["dp_fx_bar_not_in_data"]}])
