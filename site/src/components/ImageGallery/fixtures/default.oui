gallery = ImageGallery([{src: "/fixtures/images/orbit-1600x900.svg", alt: "Diagram of the probe's elliptical orbit around the planet.", width: 1600, height: 900, credit: "NASA/JPL-Caltech", licence: "Public domain", caption: "The probe's orbit."}, {src: "/fixtures/images/lander-900x1200.svg", alt: "The lander standing on its three legs on reddish ground.", width: 900, height: 1200, credit: "ESA", licence: "CC BY-SA 3.0 IGO", caption: "The lander after touchdown."}, {src: "/fixtures/images/crater-1000x1000.svg", alt: "A grey impact crater seen from directly above.", width: 1000, height: 1000, credit: "NASA/JPL-Caltech", licence: "Public domain"}], "Images released by the mission teams in the first week.")
