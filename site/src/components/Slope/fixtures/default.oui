root = Page([europe, margins])
europe = Slope("Europe's sales grew the most of any region in {pd_fy2024}", "Net sales by region, fiscal years, US$ bn", ["{pd_fy2023}", "{pd_fy2024}"], [{label: "Americas", from: "dp_aapl_sales_americas_fy2023", to: "dp_aapl_sales_americas_fy2024"}, {label: "Europe", from: "dp_aapl_sales_europe_fy2023", to: "dp_aapl_sales_europe_fy2024", highlight: true}, {label: "Greater China", from: "dp_aapl_sales_china_fy2023", to: "dp_aapl_sales_china_fy2024"}, {label: "Japan", from: "dp_aapl_sales_japan_fy2023", to: "dp_aapl_sales_japan_fy2024"}, {label: "Rest of Asia Pacific", from: "dp_aapl_sales_rapac_fy2023", to: "dp_aapl_sales_rapac_fy2024"}])
margins = Slope("Both gross margins rose between {pd_fy2020} and {pd_fy2024}", "Gross margin as a share of net sales, %", ["{pd_fy2020}", "{pd_fy2024}"], [{label: "Services", from: "dp_aapl_gm_services_fy2020", to: "dp_aapl_gm_services_fy2024"}, {label: "Products", from: "dp_aapl_gm_products_fy2020", to: "dp_aapl_gm_products_fy2024"}])
