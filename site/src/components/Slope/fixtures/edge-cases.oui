root = Page([fell, crowded, gaps, unknown])
fell = Slope("Greater China was the only region where sales fell", "Net sales by region, fiscal years, US$ bn", ["{pd_fy2023}", "{pd_fy2024}"], [{label: "Americas", from: "dp_aapl_sales_americas_fy2023", to: "dp_aapl_sales_americas_fy2024"}, {label: "Europe", from: "dp_aapl_sales_europe_fy2023", to: "dp_aapl_sales_europe_fy2024"}, {label: "Greater China", from: "dp_aapl_sales_china_fy2023", to: "dp_aapl_sales_china_fy2024", highlight: true}, {label: "Japan", from: "dp_aapl_sales_japan_fy2023", to: "dp_aapl_sales_japan_fy2024"}, {label: "Rest of Asia Pacific", from: "dp_aapl_sales_rapac_fy2023", to: "dp_aapl_sales_rapac_fy2024"}])
crowded = Slope("Close values are nudged apart and never overlap", "Synthetic values, %", ["{pd_fx_2023}", "{pd_fx_2024}"], [{label: "Other", from: "dp_fx_other_2023", to: "dp_fx_other_2024"}, {label: "Third", from: "dp_fx_third_2023", to: "dp_fx_third_2024"}, {label: "Fourth", from: "dp_fx_fourth_2023", to: "dp_fx_fourth_2024"}, {label: "Zero series, with a long name that wraps", from: "dp_fx_zero_2023", to: "dp_fx_zero_2024"}, {label: "Negative", from: "dp_fx_negative_2023", to: "dp_fx_negative_2024"}, {label: "Gaps", from: "dp_fx_gaps_2023", to: "dp_fx_gaps_2024"}, {label: "Restricted", from: "dp_fx_restricted_2023", to: "dp_fx_restricted_2024"}, {label: "Other again", from: "dp_fx_other_2022", to: "dp_fx_other_2023"}, {label: "Third again", from: "dp_fx_third_2022", to: "dp_fx_third_2023"}])
gaps = Slope("A missing end is No data, never a zero", "Synthetic values, %", ["{pd_fx_2021}", "{pd_fx_2022}"], [{label: "Second not published", from: "dp_fx_gaps_2021", to: "dp_fx_gaps_2022"}, {label: "Both present", from: "dp_fx_other_2021", to: "dp_fx_other_2022"}, {label: "First unknown", from: "dp_fx_gaps_not_in_data", to: "dp_fx_third_2022"}, {label: "Different unit", from: "dp_fx_bar_usd", to: "dp_fx_bar_usd"}])
unknown = Slope("Every value unknown", "Nothing to plot", ["Before", "After"], [{label: "One", from: "dp_fx_bar_not_in_data", to: "dp_fx_bar_not_in_data_either"}, {label: "Two", from: "dp_fx_bar_not_in_data", to: "dp_fx_bar_not_in_data_either"}])
