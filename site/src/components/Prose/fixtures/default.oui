root = Page([prose])
prose = Prose(["Apple's total net sales were {dp_aapl_net_sales_fy2024} in {pd_fy2024}, against {dp_aapl_net_sales_fy2023} a year earlier. That was {cx_aapl_first_rise_2y}.", "## Why sales rose in {pd_fy2024}", "Sales grew by {dv_aapl_net_sales_growth_fy2024}. The company reports [gross margin](glossary:gross-margin) for products and services separately.", "- Net sales in {pd_fy2023}: {dp_aapl_net_sales_fy2023}\n- Net sales in {pd_fy2024}: {dp_aapl_net_sales_fy2024}\n- Change: {dv_aapl_net_sales_growth_fy2024}", "The figures come from the company's annual reports on Form 10-K."])
