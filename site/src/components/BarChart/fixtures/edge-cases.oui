root = Page([cases, negatives, long, single, unknown, restricted])
cases = BarChart("Zero, missing, unknown and other units", "Synthetic values, %", [{label: "Positive", value: "dp_fx_bar_positive"}, {label: "Zero", value: "dp_fx_bar_zero"}, {label: "Not published", value: "dp_fx_bar_null"}, {label: "Unknown reference", value: "dp_fx_bar_not_in_data"}, {label: "Very large", value: "dp_fx_bar_large"}, {label: "Very small", value: "dp_fx_bar_small"}, {label: "Different unit", value: "dp_fx_bar_usd"}])
negatives = BarChart("Negative bars extend left of zero in the same colour", "Synthetic values, %", [{label: "A fall", value: "dp_fx_bar_negative"}, {label: "A rise", value: "dp_fx_bar_positive", highlight: true}, {label: "No change", value: "dp_fx_bar_zero"}])
long = BarChart("Sixteen items, sorted largest first", "Synthetic values, %", [{label: "Item one", value: "dp_fx_rank_1"}, {label: "Item two", value: "dp_fx_rank_2"}, {label: "Item three", value: "dp_fx_rank_3"}, {label: "Item four", value: "dp_fx_rank_4"}, {label: "Item five", value: "dp_fx_rank_5"}, {label: "Item six", value: "dp_fx_rank_6"}, {label: "Item seven", value: "dp_fx_rank_7"}, {label: "Item eight", value: "dp_fx_rank_8"}, {label: "Item nine", value: "dp_fx_rank_9"}, {label: "Item ten", value: "dp_fx_rank_10"}, {label: "Item eleven", value: "dp_fx_rank_11"}, {label: "Item twelve", value: "dp_fx_rank_12"}, {label: "Item thirteen", value: "dp_fx_rank_13"}, {label: "Item fourteen", value: "dp_fx_rank_14"}, {label: "Item fifteen", value: "dp_fx_rank_15"}, {label: "Item sixteen with a much longer label that has to wrap on a phone", value: "dp_fx_rank_16"}])
single = BarChart("One bar", "Turnout, %", [{label: "Turnout", value: "dp_fx_single_2024"}])
unknown = BarChart("Every bar unknown", "Nothing to plot", [{label: "Unknown", value: "dp_fx_bar_not_in_data"}])
restricted = BarChart("A licence that forbids downloads", "Licensed measure, %", [{label: "2023", value: "dp_fx_restricted_2023"}, {label: "2024", value: "dp_fx_restricted_2024"}])
