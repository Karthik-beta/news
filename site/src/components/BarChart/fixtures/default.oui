root = Page([regions, categories, ranked])
regions = BarChart("The Americas brought in the most sales in {pd_fy2024}", "Net sales by region, fiscal 2024, US$ bn", [{label: "Americas", value: "dp_aapl_sales_americas_fy2024"}, {label: "Europe", value: "dp_aapl_sales_europe_fy2024"}, {label: "Greater China", value: "dp_aapl_sales_china_fy2024"}, {label: "Japan", value: "dp_aapl_sales_japan_fy2024"}, {label: "Rest of Asia Pacific", value: "dp_aapl_sales_rapac_fy2024"}])
categories = BarChart("Services was Apple's second-largest source of sales", "Net sales by category, fiscal 2024, US$ bn", [{label: "iPhone", value: "dp_aapl_sales_iphone_fy2024"}, {label: "Mac", value: "dp_aapl_sales_mac_fy2024"}, {label: "iPad", value: "dp_aapl_sales_ipad_fy2024"}, {label: "Wearables, Home and Accessories", value: "dp_aapl_sales_wearables_fy2024"}, {label: "Services", value: "dp_aapl_sales_services_fy2024", highlight: true}])
ranked = BarChart("Changes in regional sales, in the order of the filing", "Change in net sales on fiscal 2023, %", [{label: "Americas", value: "dv_aapl_sales_americas_change_fy2024"}, {label: "Europe", value: "dv_aapl_sales_europe_change_fy2024"}, {label: "Greater China", value: "dv_aapl_sales_china_change_fy2024"}, {label: "Japan", value: "dv_aapl_sales_japan_change_fy2024"}, {label: "Rest of Asia Pacific", value: "dv_aapl_sales_rapac_change_fy2024"}], "given")
