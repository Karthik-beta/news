root = Page([one, odd, nokey])
one = Timeline([{date: "pd_fomc_20241218", text: "A single event: no line joins it to anything."}], "pd_fomc_20241218")
odd = Timeline([{date: "pd_test_no_start", text: "A period with no start date is written as its label, with no machine-readable date."}, {date: "pd_test_not_in_data", text: "An unknown period shows as missing; the text still reads."}, {date: "pd_test_trial_period", text: "A long period label in the date column wraps rather than pushing the text sideways, and long event text with a very long word Pneumonoultramicroscopicsilicovolcanoconiosis wraps too: {q_test_long}"}, {date: "pd_fy2024", text: "A fiscal period stays as the company labels it, {dp_aapl_net_sales_fy2024} in sales."}])
nokey = Timeline([{date: "pd_2024_01", text: "No key event: every dot is ink."}, {date: "pd_2024_06", text: "Text with no reference has no source line."}, {date: "pd_2024_12", text: "December's consumer price index stood at {dp_us_cpi_2024_12}."}])
