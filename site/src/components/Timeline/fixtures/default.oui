steps = Timeline([{date: "pd_fomc_20220316", text: "The Fed raised its rate for the first time in this cycle, to {dp_fed_upper_20220316}."}, {date: "pd_fomc_20230726", text: "The last rise of the cycle took the upper limit to {dp_fed_upper_20230726}."}, {date: "pd_fomc_20240918", text: "The first cut, by {dp_fed_change_20240918}: {q_fomc_statement_sep_2024}"}, {date: "pd_fomc_20241107", text: "A second cut, to {dp_fed_upper_20241107}."}, {date: "pd_fomc_20241218", text: "A third cut, to {dp_fed_upper_20241218}, by a vote of {cx_fomc_vote_20241218}."}], "pd_fomc_20240918")
