root = Page([loss, gap, mismatch, unknown, otherunit])
loss = Waterfall("A net loss after an operating loss and a tax credit", "Synthetic income statement, US$ m", [{label: "Revenue", value: "dp_fx_wf_revenue", kind: "total"}, {label: "Cost of revenue", value: "dp_fx_wf_cost", kind: "deduct"}, {label: "Gross profit", value: "dp_fx_wf_gross", kind: "total"}, {label: "Operating expenses", value: "dp_fx_wf_opex", kind: "deduct"}, {label: "Operating loss", value: "dp_fx_wf_operating", kind: "total"}, {label: "Income tax", value: "dp_fx_wf_tax", kind: "deduct"}, {label: "Net loss", value: "dp_fx_wf_net", kind: "total"}])
gap = Waterfall("A line with no value breaks the running total until the next total", "Synthetic income statement, US$ m", [{label: "Revenue", value: "dp_fx_wf_revenue", kind: "total"}, {label: "Cost of revenue", value: "dp_fx_wf_cost", kind: "deduct"}, {label: "Restructuring charges", value: "dp_fx_wf_null", kind: "deduct"}, {label: "Operating expenses", value: "dp_fx_wf_opex", kind: "deduct"}, {label: "Operating loss", value: "dp_fx_wf_operating", kind: "total"}, {label: "Unknown reference", value: "dp_fx_wf_not_in_data", kind: "deduct"}, {label: "Net loss", value: "dp_fx_wf_net", kind: "total"}])
mismatch = Waterfall("Lines left out do not add up to the total", "Synthetic income statement, US$ m", [{label: "Revenue", value: "dp_fx_wf_revenue", kind: "total"}, {label: "Cost of revenue", value: "dp_fx_wf_cost", kind: "deduct"}, {label: "Operating loss", value: "dp_fx_wf_operating", kind: "total"}])
unknown = Waterfall("Every line unknown", "Nothing to plot", [{label: "Revenue", value: "dp_fx_wf_not_in_data", kind: "total"}, {label: "Cost", value: "dp_fx_wf_not_in_data_either", kind: "deduct"}])
otherunit = Waterfall("A line in another unit is left out, never converted", "Synthetic income statement, US$ m", [{label: "Revenue", value: "dp_fx_wf_revenue", kind: "total"}, {label: "Cost of revenue", value: "dp_fx_wf_cost", kind: "deduct"}, {label: "Different unit", value: "dp_fx_bar_usd", kind: "deduct"}, {label: "Gross profit", value: "dp_fx_wf_gross", kind: "total"}])
