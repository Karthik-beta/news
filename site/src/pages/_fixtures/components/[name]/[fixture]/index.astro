---
// Component fixture pages: src/components/<Name>/fixtures/<fixture>.oui rendered by the real renderer with the
// fixture data, glossary and images, hosted in the fixture layout. For the component tester. NEWS_FIXTURES=1 only.
import { componentFixturePaths, renderComponentFixture } from "../../../../../renderer/fixtures/component-pages";
import FixtureLayout from "../../../../../renderer/fixtures/FixtureLayout.astro";

export function getStaticPaths() {
  return componentFixturePaths();
}

const { name, fixture } = Astro.params as { name: string; fixture: string };
const result = renderComponentFixture(name, fixture);
---
<FixtureLayout title={`Fixture: ${name}, ${fixture}`} hasIslands={result.hasIslands}>
  <Fragment set:html={result.article} />
</FixtureLayout>
