root = Page([figures, services, regions, categories, margins, path, cpi, table, compare, income, flows, regionmix, categorymix, regionchange, regionslope, marginpanels, cpispread, marginheat, g7map])
income = Waterfall("Apple kept about a quarter of its sales as net income in {pd_fy2024}", "Consolidated statement of operations, fiscal 2024, US$ bn", [{label: "Total net sales", value: "dp_aapl_net_sales_fy2024", kind: "total"}, {label: "Total cost of sales", value: "dp_aapl_cost_of_sales_fy2024", kind: "deduct"}, {label: "Gross margin", value: "dp_aapl_gross_margin_fy2024", kind: "total"}, {label: "Research and development", value: "dp_aapl_rnd_fy2024", kind: "deduct"}, {label: "Selling, general and administrative", value: "dp_aapl_sga_fy2024", kind: "deduct"}, {label: "Operating income", value: "dp_aapl_operating_income_fy2024", kind: "total"}, {label: "Other income/(expense), net", value: "dp_aapl_other_income_fy2024", kind: "add"}, {label: "Income before provision for income taxes", value: "dp_aapl_pretax_income_fy2024", kind: "total"}, {label: "Provision for income taxes", value: "dp_aapl_tax_fy2024", kind: "deduct"}, {label: "Net income", value: "dp_aapl_net_income_fy2024", kind: "total"}])
