root = Page([figures, services, regions, categories, margins, path, cpi, table, compare])
figures = KeyFigures([servicesFigure, marginFigure, chinaFigure])
servicesFigure = KeyFigure("Services net sales", "dp_aapl_sales_services_fy2024", "dv_aapl_services_change_fy2024", "pd_fy2023", "sr_aapl_services_5y")
marginFigure = KeyFigure("Services gross margin", "dp_aapl_gm_services_fy2024", "dv_aapl_gm_services_change_fy2024", "pd_fy2023", "sr_aapl_gm_services")
chinaFigure = KeyFigure("Greater China net sales", "dp_aapl_sales_china_fy2024", "dv_aapl_sales_china_change_fy2024", "pd_fy2023")
services = ColumnChart("Services sales have grown every year since {pd_fy2020}", "Services net sales, fiscal years, US$ bn", ["sr_aapl_services_5y"], "pd_fy2024")
regions = BarChart("The Americas brought in the most sales in {pd_fy2024}", "Net sales by region, fiscal 2024, US$ bn", [{label: "Americas", value: "dp_aapl_sales_americas_fy2024"}, {label: "Europe", value: "dp_aapl_sales_europe_fy2024"}, {label: "Greater China", value: "dp_aapl_sales_china_fy2024"}, {label: "Japan", value: "dp_aapl_sales_japan_fy2024"}, {label: "Rest of Asia Pacific", value: "dp_aapl_sales_rapac_fy2024"}])
categories = BarChart("Services was Apple's second-largest source of sales", "Net sales by category, fiscal 2024, US$ bn", [{label: "iPhone", value: "dp_aapl_sales_iphone_fy2024"}, {label: "Mac", value: "dp_aapl_sales_mac_fy2024"}, {label: "iPad", value: "dp_aapl_sales_ipad_fy2024"}, {label: "Wearables, Home and Accessories", value: "dp_aapl_sales_wearables_fy2024"}, {label: "Services", value: "dp_aapl_sales_services_fy2024", highlight: true}])
margins = LineChart("Services earns about twice the gross margin of products", "Gross margin as a share of net sales, fiscal years, %", ["sr_aapl_gm_services", "sr_aapl_gm_products"], "sr_aapl_gm_services", "sr_aapl_gm_products")
path = StepLineChart("The Fed has cut three times since {pd_fomc_20240918}", "Federal funds target range, upper limit, %", ["sr_fed_funds_upper"], ["pd_fomc_20220316", "pd_fomc_20230726", "pd_fomc_20240918"])
cpi = LineChart("Inflation in America ended the year below where it started", "Consumer prices, change on a year earlier, 2024, %", ["sr_us_cpi_2024"], null, null, false)
table = DataTable("Services margins have stayed about twice those of products", "Gross margin as a share of net sales, fiscal years, %", ["sr_aapl_gm_products", "sr_aapl_gm_services"], "pd_fy2024")
compare = ComparisonTable("Greater China was the only region where sales fell", "Net sales by region", ["{pd_fy2023}", "{pd_fy2024}"], [{label: "Americas", a: "dp_aapl_sales_americas_fy2023", b: "dp_aapl_sales_americas_fy2024", change: "dv_aapl_sales_americas_change_fy2024"}, {label: "Europe", a: "dp_aapl_sales_europe_fy2023", b: "dp_aapl_sales_europe_fy2024", change: "dv_aapl_sales_europe_change_fy2024"}, {label: "Greater China", a: "dp_aapl_sales_china_fy2023", b: "dp_aapl_sales_china_fy2024", change: "dv_aapl_sales_china_change_fy2024"}, {label: "Japan", a: "dp_aapl_sales_japan_fy2023", b: "dp_aapl_sales_japan_fy2024", change: "dv_aapl_sales_japan_change_fy2024"}, {label: "Rest of Asia Pacific", a: "dp_aapl_sales_rapac_fy2023", b: "dp_aapl_sales_rapac_fy2024", change: "dv_aapl_sales_rapac_change_fy2024"}])
