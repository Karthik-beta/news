  "quotes": {
    "q_fomc_statement_sep_2024": {
      "text": "In light of the progress on inflation and the balance of risks, the Committee decided to lower the target range for the federal funds rate by 1/2 percentage point to 4-3/4 to 5 percent.",
      "source": "src_fomc_statement_sep_2024",
      "speaker": "Federal Open Market Committee",
      "role": null,
      "said_on": "2024-09-18",
      "locator": {
        "kind": "html",
        "paragraph": 2
      }
    },
    "q_test_trial_limitations": {
      "text": "Participants were not blinded to their group, and blood pressure was measured at clinics that knew the allocation.",
      "source": "src_test_trial",
      "speaker": "The study's authors",
      "role": null,
      "said_on": null,
      "locator": {
        "kind": "pdf",
        "page": 9
      }
    },
    "q_test_long": {
      "text": "The committee judged that the risks to achieving its employment and inflation goals were roughly in balance, that the economic outlook was uncertain, and that it would carefully assess incoming data, the evolving outlook and the balance of risks before considering any further adjustments to the target range, while remaining strongly committed to supporting maximum employment and returning inflation to its objective over the medium term.",
      "source": "src_test_trial",
      "speaker": "A spokesperson for a very long-named international standards and statistics coordination organisation",
      "role": "Head of communications and public engagement",
      "said_on": "2026-09-30",
      "locator": {
        "kind": "pdf",
        "page": 1
      }
    },
    "q_test_bare": {
      "text": "Rates were held.",
      "source": "src_test_trial",
      "locator": {
        "kind": "pdf",
        "page": 1
      }
    },
    "q_fomc_stance_dec_2024": {
      "text": "In considering the extent and timing of additional adjustments to the target range for the federal funds rate, the Committee will carefully assess incoming data, the evolving outlook, and the balance of risks.",
      "source": "src_fomc_statement_dec_2024",
      "speaker": "Federal Open Market Committee",
      "role": null,
      "said_on": "2024-12-18",
