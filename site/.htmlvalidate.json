{
  "$schema": "https://html-validate.org/schemas/config.json",
  "root": true,
  "extends": ["html-validate:recommended", "html-validate:document"],
  "rules": {
    "attribute-boolean-style": "off",
    "attr-case": ["error", { "style": ["lowercase", "camelcase"] }],
    "attribute-empty-style": "off",
    "doctype-style": "off",
    "void-style": "off",
    "no-trailing-whitespace": "off",
    "require-sri": [
      "error",
      {
        "target": "crossorigin"
      }
    ],
    "no-inline-style": [
      "error",
      {
        "allowedProperties": [
          "display",
          "left",
          "top",
          "right",
          "bottom",
          "width",
          "height",
          "--chart-axis-width",
          "--bar-zero",
          "--bar-room-negative",
          "--bar-room-positive",
          "--line-end-room-phone",
          "--line-end-room-wide"
        ]
      }
    ]
  }
}
