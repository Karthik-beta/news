{
  "$schema": "https://html-validate.org/schemas/config.json",
  "root": true,
  "extends": [
    "html-validate:recommended",
    "html-validate:document"
  ],
  "rules": {
    "attribute-boolean-style": "off",
    "attribute-empty-style": "off",
    "doctype-style": "off",
    "void-style": "off",
    "no-trailing-whitespace": "off",
    "require-sri": [
      "error",
      {
        "target": "crossorigin"
      }
    ],
    "no-inline-style": [
      "error",
      {
        "allowedProperties": [
          "display",
          "left",
          "top"
        ]
      }
    ]
  }
}
