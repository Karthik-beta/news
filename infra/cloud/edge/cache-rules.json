[
  {
    "ref": "news-cache-articles",
    "description": "Article pages come from R2: cache them at the edge for a day (publishing purges the URL), a miss for a minute",
    "expression": "(http.host eq \"${DOMAIN}\" and starts_with(http.request.uri.path, \"/2\"))",
    "action": "set_cache_settings",
    "action_parameters": {
      "cache": true,
      "edge_ttl": {
        "mode": "override_origin",
        "default": 86400,
        "status_code_ttl": [{ "status_code": 404, "value": 60 }]
      },
      "browser_ttl": { "mode": "respect_origin" }
    },
    "enabled": true
  }
]
