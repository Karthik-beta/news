    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "aws4fetch": "1.0.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@types/node": "^26.6.6",
    "ajv": "8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
