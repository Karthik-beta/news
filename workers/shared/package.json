{
  "name": "@news/worker-shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Code shared by the Workers: DynamoDB client, fake and read layer, D1 search, R2, purge, precompiled validators, curation checks.",
  "exports": {
    "./validators": "./src/generated/validators.js",
