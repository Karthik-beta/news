{
  // Public search API over D1 (Phase 6). Read-only: GET /v1/search.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "news-search",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Our own logs only: invocation logs record client IPs, which these Workers never keep (ADR 0006).
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // The origin the result URLs are built on (the site's, as in the api Worker).
  "vars": { "NEWS_SITE_ORIGIN": "https://news.karthik.nz" },
  "ratelimits": [{ "name": "SEARCH_RATE_LIMITER", "namespace_id": "1302", "simple": { "limit": 30, "period": 60 } }]

  // TODO(Karthik, Phase 6 provisioning, #21): declare the real D1 shards here, one per year, the same databases the
  // api Worker writes (this Worker only runs SELECTs): binding SEARCH_<YYYY>.
  //   "d1_databases": [{ "binding": "SEARCH_2026", "database_name": "news-search-2026", "database_id": "<real D1 id>" }],
  // The tests do NOT read these: Miniflare creates empty local D1 databases (workers/test-support).
}
