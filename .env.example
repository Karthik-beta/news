# Local development settings. `bun run setup` copies this to .env and generates the passwords.
# .env is git-ignored. Never commit real values.
# Avoid `$` in values: Bun expands it for every Bun-run tool (`bun run doctor` warns). Compose gets values as written.

# PostgreSQL + pgvector (container news-postgres; 5432 is the native PostgreSQL on this laptop)
NEWS_PG_PORT=5433
NEWS_PG_PASSWORD=
DATABASE_URL=

# Shared ClickHouse (container from another project; News has its own database and user)
NEWS_CH_CONTAINER=shorts-clickhouse-1
NEWS_CH_HTTP=http://127.0.0.1:8123
NEWS_CH_OTEL_ENDPOINT=http://host.docker.internal:8123
NEWS_CH_USER=news
NEWS_CH_PASSWORD=

# DynamoDB Local (container news-dynamodb): AWS's own emulator, in memory, used by the Worker tests.
# Dummy credentials on purpose, and deliberately NOT the AWS_* variables below, so tests can never pick up real keys.
# The tests and `bun run doctor` refuse any endpoint that is not 127.0.0.1 / localhost.
NEWS_DYNAMODB_PORT=8000
NEWS_DYNAMODB_ENDPOINT=http://127.0.0.1:8000
NEWS_DYNAMODB_REGION=us-east-1
NEWS_DYNAMODB_ACCESS_KEY_ID=AKIDLOCAL
NEWS_DYNAMODB_SECRET_ACCESS_KEY=local

# Astro: no usage telemetry
ASTRO_TELEMETRY_DISABLED=1

# OpenUI (@openuidev/lang-core): no install or runtime telemetry (ADR 0001). Keep the package out of trustedDependencies.
OPENUI_TELEMETRY_DISABLED=1

# OpenTelemetry Collector (container news-otel)
NEWS_OTEL_HTTP=http://127.0.0.1:4318
NEWS_OTEL_HEALTH=http://127.0.0.1:13133

# Pipeline settings (Technical Design, "Environment variables")
NEWS_TARGET_PAGES=100
NEWS_INDEX_PER_DAY=20
SAMPLE_RATE=0.05
NEWS_PARALLEL=3
NEWS_MODEL_MAIN=sonnet
NEWS_MODEL_LIGHT=haiku
NEWS_MODEL_CURATOR=sonnet
NEWS_HOME_STALE_DAYS=4
BACKFILL_FROM=2026-01-01
# Bureau design §14: run token ceiling (input-equivalent), raw snapshot retention (decision D7)
NEWS_AI_RUN_TOKENS=2500000
NEWS_RAW_RETAIN_DAYS_DATA=400
NEWS_RAW_RETAIN_DAYS_DOCS=90
# Contact e-mail for the User-Agent of sources that require one (SEC EDGAR); a dedicated address (decision D14).
# Karthik fills it in; agents never edit it.
NEWS_CONTACT_EMAIL=

# The news CLI (cli/README.md). DATABASE_URL above is its database; tables live in this schema.
NEWS_DB_SCHEMA=news
# stderr log filter for the CLI (tracing EnvFilter syntax): warn, info, debug
NEWS_LOG=warn
# `off` stops the CLI's ClickHouse events and OTLP spans (they go to NEWS_CH_HTTP and NEWS_OTEL_HTTP)
NEWS_TELEMETRY=on
# component-index.json for `news components`; empty = site/dist/component-index.json (built by the site)
NEWS_COMPONENT_INDEX=
# NEWS_RUN_ID and NEWS_JOB_ID are set per call by Chief and Ghost, never here.

# Claude Code telemetry, applied by the pipeline runner to its `claude -p` calls (not globally)
CLAUDE_CODE_ENABLE_TELEMETRY=1
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# Cloud credentials: filled in by Karthik only (Phase 0 accounts step). Agents never edit these.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEWS_WRITE_API_KEY=
