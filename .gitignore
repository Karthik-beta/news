# Secrets and local config (never commit)
.env
.env.*
!.env.example
secrets/
*.pem
*.key
.dev.vars
.wrangler/

# Pipeline working files (pruned after publish; see Technical Design)
work/

# Dependencies and build output
node_modules/
dist/
.astro/
target/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Python (Docling helper)
__pycache__/
.venv/

# Local databases and data volumes
*.sqlite
*.sqlite3
# Only the root data/ is local; Contacts source rows (data/sources/<id>.toml), the Diary seed file
# (data/calendar/), the Roster seed lists (data/roster/) and the scorer seeds (data/seeds/) are
# reviewed like code.
/data/*
!/data/sources/
!/data/calendar/
!/data/roster/
!/data/seeds/

# Claude Code local files
.claude/settings.local.json
.claude/worktrees/

# OS and editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Generated copies (made by site/scripts/sync-tokens.ts and site/scripts/sync-fonts.ts)
site/src/styles/tokens.css
site/public/fonts/
