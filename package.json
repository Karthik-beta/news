{
  "name": "news",
  "private": true,
  "type": "module",
  "workspaces": [
    "site",
    "workers/*",
    "pipeline",
    "dashboard"
  ],
  "scripts": {
    "setup": "bun --no-env-file scripts/setup.ts",
    "doctor": "bun scripts/doctor.ts",
    "infra:up": "bun --no-env-file scripts/compose.ts up -d --wait",
    "infra:down": "bun --no-env-file scripts/compose.ts down",
    "infra:logs": "bun --no-env-file scripts/compose.ts logs -f --tail=100",
    "clickhouse:setup": "bun scripts/clickhouse-setup.ts",
    "work": "bun --no-env-file scripts/work.ts",
    "tokens": "bun design/tokens/build.mjs",
    "dev": "bun --filter @news/site dev",
    "build": "bun --filter '*' build",
    "test": "bun --filter '*' test",
    "test:integration": "bun --filter '*' test:integration && bun scripts/test-cli.ts integration",
    "test:e2e": "bun --filter '*' test:e2e",
    "validate": "bun scripts/validate-config.ts && bun scripts/validate-skills.ts",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/bun": "^1.4.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
