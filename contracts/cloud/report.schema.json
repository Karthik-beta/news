{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cloud/report.schema.json",
  "title": "Reader error reports",
  "description": "Public report intake (POST /v1/reports) and the stored record that `news corrections pull` reads (GET /v1/reports). The record holds the report text, the page and the optional e-mail; never the IP address, user agent or any other request detail. Spam controls: ADR 0006.",
  "$defs": {
    "intake": {
      "description": "Body of POST /v1/reports. `website` is a honeypot: people never see the field, so it must be empty or absent.",
      "type": "object",
      "additionalProperties": false,
      "required": ["page_id", "text"],
      "properties": {
        "page_id": { "$ref": "common.schema.json#/$defs/pageId" },
        "kind": { "$ref": "#/$defs/kind" },
        "text": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "email": { "$ref": "#/$defs/email" },
        "lang": { "$ref": "common.schema.json#/$defs/lang" },
        "website": { "type": "string", "maxLength": 200 }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "page_id", "page_path", "kind", "text", "lang", "created_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^r_[0-9a-f]{32}$" },
        "page_id": { "$ref": "common.schema.json#/$defs/pageId" },
        "page_path": { "$ref": "common.schema.json#/$defs/pagePath" },
        "kind": { "$ref": "#/$defs/kind" },
        "text": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "email": { "$ref": "#/$defs/email" },
        "lang": { "$ref": "common.schema.json#/$defs/lang" },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "kind": {
      "type": "string",
      "enum": ["figure", "wording", "link", "image", "other"]
    },
    "email": {
      "type": "string",
      "maxLength": 254,
      "pattern": "^[^\\s@<>()\\[\\],;:\"]{1,64}@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$"
    }
  }
}
