            "const": "run.start"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "$ref": "commands/run.start.schema.json#/$defs/input"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cmd": {
            "const": "run.start_after_pause"
          }
        }
      },
      "then": {
        "properties": {
