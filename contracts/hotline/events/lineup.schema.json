{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/hotline/events/lineup.schema.json",
  "title": "Hotline event lineup",
  "description": "The Lineup or the slot holder changed; carries the whole Lineup. Validates the event's data.",
  "x-hotline-topic": "lineup",
  "x-news-status": "#10",
  "$defs": {
    "data": {
      "type": "object",
      "properties": {
        "heavy_slot": {
          "$ref": "../common.schema.json#/$defs/heavySlot"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/lineupEntry"
          }
        }
      },
      "required": ["heavy_slot", "items"],
      "additionalProperties": false
    }
  }
}
