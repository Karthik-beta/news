{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/hotline/commands/service.log.schema.json",
  "title": "Hotline service.log",
  "description": "Recent service log lines at info and above, from the in-memory ring (2,000 lines). Input is the request's args; output is the reply envelope's data.",
  "x-news-tier": "R",
  "x-hotline-from": ["board", "terminal"],
  "x-news-status": "#10",
  "x-news-cli": null,
  "x-news-errors": ["usage"],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "after_seq": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "level": {
          "enum": ["info", "warn", "error"]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/logLine"
          }
        },
        "last_seq": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["items", "last_seq"],
      "additionalProperties": false
    }
  }
}
