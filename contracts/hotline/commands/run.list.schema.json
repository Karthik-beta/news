{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/hotline/commands/run.list.schema.json",
  "title": "Hotline run.list",
  "description": "Recent runs, newest first. Input is the request's args; output is the reply envelope's data.",
  "x-news-tier": "R",
  "x-hotline-from": ["board", "terminal"],
  "x-news-status": "#10",
  "x-news-cli": "news run list",
  "x-news-errors": ["usage", "upstream_unavailable"],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean",
          "description": "Only runs that are not finished"
        },
        "preset": {
          "$ref": "../common.schema.json#/$defs/presetId"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": "string",
          "description": "next_cursor of the previous page"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "run_id": {
                "$ref": "../common.schema.json#/$defs/uuid"
              },
              "short_id": {
                "$ref": "../common.schema.json#/$defs/shortId"
              },
              "preset": {
                "$ref": "../common.schema.json#/$defs/presetId"
              },
              "status": {
                "$ref": "../common.schema.json#/$defs/runStatus"
              },
              "origin": {
                "$ref": "../common.schema.json#/$defs/origin"
              },
              "created_at": {
                "$ref": "../common.schema.json#/$defs/timestamp"
              },
              "started_at": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/timestamp"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "finished_at": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/timestamp"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "headline": {
                "$ref": "../common.schema.json#/$defs/text"
              }
            },
            "required": [
              "run_id",
              "short_id",
              "preset",
              "status",
              "origin",
              "created_at",
              "started_at",
              "finished_at",
              "headline"
            ],
            "additionalProperties": false
          }
        },
        "next_cursor": {
          "type": "string"
        }
      },
      "required": ["items"],
      "additionalProperties": false
    }
  }
}
