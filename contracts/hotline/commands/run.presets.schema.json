{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/hotline/commands/run.presets.schema.json",
  "title": "Hotline run.presets",
  "description": "The preset catalogue from Chief's Rust declarations: arguments (Board builds its Start and schedule forms from them), heavy, writes, publishes, gates and steps. Input is the request's args; output is the reply envelope's data.",
  "x-news-tier": "R",
  "x-hotline-from": ["board", "terminal"],
  "x-news-status": "#10",
  "x-news-cli": "news run presets",
  "x-news-errors": [],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/presetDecl"
          },
          "minItems": 11,
          "maxItems": 11
        }
      },
      "required": ["items"],
      "additionalProperties": false
    }
  }
}
