{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/hotline/commands/run.resume.schema.json",
  "title": "Hotline run.resume",
  "description": "Resume a paused run from its current step; it joins the Lineup when it is heavy and the slot is busy. Input is the request's args; output is the reply envelope's data.",
  "x-news-tier": "H",
  "x-hotline-from": ["board"],
  "x-news-status": "#10",
  "x-news-cli": null,
  "x-news-errors": ["usage", "not_found", "precondition", "gated", "upstream_unavailable"],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "run": {
          "$ref": "../common.schema.json#/$defs/runRef"
        }
      },
      "required": ["run"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        "short_id": {
          "$ref": "../common.schema.json#/$defs/shortId"
        },
        "status": {
          "enum": ["running", "queued"]
        },
        "position": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "$ref": "../common.schema.json#/$defs/text"
        }
      },
      "required": ["run_id", "short_id", "status", "position", "text"],
      "additionalProperties": false
    }
  }
}
