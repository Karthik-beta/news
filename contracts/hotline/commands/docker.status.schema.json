{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/hotline/commands/docker.status.schema.json",
  "title": "Hotline docker.status",
  "description": "Health of the News containers (start and stop allowed) and the shared ClickHouse (health only). Handler built in #29; #10 answers precondition. Input is the request's args; output is the reply envelope's data.",
  "x-news-tier": "R",
  "x-hotline-from": ["board", "terminal"],
  "x-news-status": "#29",
  "x-news-cli": null,
  "x-news-errors": ["precondition", "upstream_unavailable"],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "object",
          "properties": {
            "reachable": {
              "type": "boolean"
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["reachable", "reason"],
          "additionalProperties": false
        },
        "containers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "enum": ["postgres", "otel", "dynamodb", "clickhouse", "other"]
              },
              "managed": {
                "type": "boolean",
                "description": "A News container Board may start and stop"
              },
              "state": {
                "enum": ["running", "starting", "exited", "missing", "unknown"]
              },
              "health": {
                "enum": ["healthy", "unhealthy", "starting", "none", "unknown"]
              },
              "started_at": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/timestamp"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["name", "role", "managed", "state", "health", "started_at"],
            "additionalProperties": false
          }
        },
        "text": {
          "$ref": "../common.schema.json#/$defs/text"
        }
      },
      "required": ["engine", "containers", "text"],
      "additionalProperties": false
    }
  }
}
