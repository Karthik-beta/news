{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/hotline/commands/standing.history.schema.json",
  "title": "Hotline standing.history",
  "description": "Standing versions, newest first: who, when, the note and each key's old and new value. Input is the request's args; output is the reply envelope's data.",
  "x-news-tier": "R",
  "x-hotline-from": ["board", "terminal"],
  "x-news-status": "#10",
  "x-news-cli": "news standing history",
  "x-news-errors": ["usage", "upstream_unavailable"],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "../common.schema.json#/$defs/settingKey"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "who": {
                "enum": ["board", "seed"]
              },
              "created_at": {
                "$ref": "../common.schema.json#/$defs/timestamp"
              },
              "note": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "changes": {
                "type": "array",
                "items": {
                  "$ref": "../common.schema.json#/$defs/standingChange"
                }
              }
            },
            "required": ["version", "who", "created_at", "note", "changes"],
            "additionalProperties": false
          }
        },
        "next_cursor": {
          "type": "string"
        }
      },
      "required": ["items"],
      "additionalProperties": false
    }
  }
}
