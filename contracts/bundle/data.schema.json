{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "points": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^dp_[a-z0-9]+(_[a-z0-9]+)*$",
        "description": "A dp_… reference."
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "The source's own label, verbatim."
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                "description": "An exact decimal, as a string: optional minus, no exponent, no grouping."
              },
              {
                "type": "null"
              }
            ],
            "description": "Exact decimal parsed from value_text; null when the source did not publish a value."
          },
          "value_text": {
            "description": "The value exactly as published ('1,234.5', '-0.3').",
            "type": ["string", "null"]
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "description": "Verbatim unit ('USD', 'Percent', 'Index 1982-84=100')."
          },
          "currency": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "description": "ISO 4217 code when the value is money. Never converted."
              },
              {
                "type": "null"
              }
            ]
          },
          "scale": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["units", "thousands", "millions", "billions", "trillions"],
                "description": "The scale the source states the value in. The value is NOT multiplied by it."
              },
              {
                "type": "null"
              }
            ]
          },
          "decimals": {
            "description": "Digits after the point the source is precise to (XBRL @decimals), in the value's scale.",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "period": {
            "type": "string",
            "pattern": "^pd_[a-z0-9]+(_[a-z0-9]+)*$",
            "description": "A pd_… reference."
          },
          "seasonal_adjustment": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["SA", "NSA", "SAAR"]
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "string",
            "pattern": "^src_[a-z0-9]+(_[a-z0-9]+)*$",
            "description": "A page-local source ID, src_…."
          },
          "locator": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["kind"],
            "additionalProperties": {},
            "description": "Where the value sits inside the stored source document: XBRL tag and context, JSON path, PDF page and table, SDMX key."
          },
          "supersedes": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^dp_[a-z0-9]+(_[a-z0-9]+)*$",
                "description": "A dp_… reference."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["label", "value", "value_text", "unit", "currency", "scale", "period", "source", "locator"],
        "additionalProperties": false
      },
      "description": "dp_… data points."
    },
    "derived": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^dv_[a-z0-9]+(_[a-z0-9]+)*$",
        "description": "A dv_… reference."
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "description": "An exact decimal, as a string: optional minus, no exponent, no grouping."
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "description": "'%' for pct_change and share, 'pp' for pp_change, else the inputs' unit."
          },
          "currency": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "description": "ISO 4217 code when the value is money. Never converted."
              },
              {
                "type": "null"
              }
            ]
          },
          "scale": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["units", "thousands", "millions", "billions", "trillions"],
                "description": "The scale the source states the value in. The value is NOT multiplied by it."
              },
              {
                "type": "null"
              }
            ]
          },
          "formula": {
            "type": "string",
            "enum": ["pct_change", "pp_change", "diff", "share"]
          },
          "inputs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^dp_[a-z0-9]+(_[a-z0-9]+)*$",
              "description": "A dp_… reference."
            }
          },
          "rounding": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Digits after the point the value was rounded to."
          }
        },
        "required": ["label", "value", "unit", "currency", "scale", "formula", "inputs", "rounding"],
        "additionalProperties": false
      },
      "description": "dv_… derived values."
    },
    "series": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^sr_[a-z0-9]+(_[a-z0-9]+)*$",
        "description": "A sr_… reference."
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "currency": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "description": "ISO 4217 code when the value is money. Never converted."
              },
              {
                "type": "null"
              }
            ]
          },
          "scale": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["units", "thousands", "millions", "billions", "trillions"],
                "description": "The scale the source states the value in. The value is NOT multiplied by it."
              },
              {
                "type": "null"
              }
            ]
          },
          "points": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "period": {
                  "type": "string",
                  "pattern": "^pd_[a-z0-9]+(_[a-z0-9]+)*$",
                  "description": "A pd_… reference."
                },
                "point": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^dp_[a-z0-9]+(_[a-z0-9]+)*$",
                      "description": "A dp_… reference."
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["period", "point"],
              "additionalProperties": false
            },
            "description": "In time order. `point: null` marks a missing observation."
          }
        },
        "required": ["label", "unit", "currency", "scale", "points"],
        "additionalProperties": false
      },
      "description": "sr_… series."
    },
    "periods": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^pd_[a-z0-9]+(_[a-z0-9]+)*$",
        "description": "A pd_… reference."
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "A calendar date, YYYY-MM-DD."
              },
              {
                "type": "null"
              }
            ]
          },
          "end": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "A calendar date, YYYY-MM-DD."
              },
              {
                "type": "null"
              }
            ]
          },
          "fiscal": {
            "description": "True when the label is the company's own fiscal period.",
            "type": "boolean"
          }
        },
        "required": ["label"],
        "additionalProperties": false
      },
      "description": "pd_… period labels."
    },
    "quotes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^q_[a-z0-9]+(_[a-z0-9]+)*$",
        "description": "A q_… reference."
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "pattern": "^src_[a-z0-9]+(_[a-z0-9]+)*$",
            "description": "A page-local source ID, src_…."
          },
          "speaker": {
            "type": ["string", "null"]
          },
          "role": {
            "type": ["string", "null"]
          },
          "said_on": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "A calendar date, YYYY-MM-DD."
              },
              {
                "type": "null"
              }
            ]
          },
          "locator": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["kind"],
            "additionalProperties": {},
            "description": "Where the value sits inside the stored source document: XBRL tag and context, JSON path, PDF page and table, SDMX key."
          }
        },
        "required": ["text", "source", "locator"],
        "additionalProperties": false
      },
      "description": "q_… quotes."
    },
    "context": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^cx_[a-z0-9]+(_[a-z0-9]+)*$",
        "description": "A cx_… reference."
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(dp|dv|sr|pd|q|cx)_[a-z0-9]+(_[a-z0-9]+)*$"
            }
          }
        },
        "required": ["text", "rule"],
        "additionalProperties": false
      },
      "description": "cx_… context lines."
    }
  },
  "required": ["version", "points", "derived", "series", "periods", "quotes", "context"],
  "additionalProperties": false,
  "title": "News page bundle: data.json",
  "description": "Every value a page references, exactly as the source states it, keyed by reference.",
  "$id": "https://news.karthik.nz/contracts/bundle/data.schema.json"
}
