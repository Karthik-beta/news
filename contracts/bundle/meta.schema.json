{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/bundle/meta.schema.json",
  "title": "Page bundle meta.json (meta.v1)",
  "description": "The page's metadata, written by the renderer into the bundle and validated again by the write API. Holds no figures: values live in data.json and are referenced by ID.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "path",
    "version",
    "lang",
    "title",
    "summary",
    "page_type",
    "tier",
    "categories",
    "entities",
    "tags",
    "region",
    "published_at",
    "updated_at",
    "index_status",
    "renderer_version",
    "data_ids",
    "chart_ids"
  ],
  "properties": {
    "schema": { "const": "meta.v1" },
    "id": { "$ref": "../cloud/common.schema.json#/$defs/pageId" },
    "path": { "$ref": "../cloud/common.schema.json#/$defs/pagePath" },
    "version": { "type": "integer", "minimum": 1, "maximum": 999999 },
    "lang": { "$ref": "../cloud/common.schema.json#/$defs/lang" },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "fly_title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "page_type": { "$ref": "../cloud/common.schema.json#/$defs/pageType" },
    "tier": { "type": "integer", "minimum": 1, "maximum": 3 },
    "categories": {
      "description": "The first category is the page's primary category.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "../cloud/common.schema.json#/$defs/categorySlug" }
    },
    "entities": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind"],
        "properties": {
          "id": { "$ref": "../cloud/common.schema.json#/$defs/entityId" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "kind": { "$ref": "../cloud/common.schema.json#/$defs/entityKind" }
        }
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 60 }
    },
    "region": { "$ref": "../cloud/common.schema.json#/$defs/region" },
    "published_at": { "$ref": "../cloud/common.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "../cloud/common.schema.json#/$defs/timestamp" },
    "index_status": { "$ref": "../cloud/common.schema.json#/$defs/indexStatus" },
    "renderer_version": { "type": "string", "minLength": 1, "maxLength": 40 },
    "data_ids": {
      "description": "IDs of the figures in data.json that a curation slot may show.",
      "type": "array",
      "maxItems": 2000,
      "uniqueItems": true,
      "items": { "$ref": "../cloud/common.schema.json#/$defs/dataId" }
    },
    "chart_ids": {
      "description": "IDs of the page's charts; each has charts/<id>.csv in the bundle when it has tabular data.",
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": { "$ref": "../cloud/common.schema.json#/$defs/chartId" }
    },
    "flags": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["templated"] }
    }
  }
}
