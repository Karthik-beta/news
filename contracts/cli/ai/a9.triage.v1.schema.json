{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/ai/a9.triage.v1.schema.json",
  "title": "A9 triage",
  "description": "Triage a reader error report (Bureau §7.1 A9).",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "figure",
        "wording",
        "link",
        "image",
        "other",
        "spam"
      ]
    },
    "ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(dp|dv|sr|pd|q|cx)_[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "claim": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "kind",
    "ref",
    "claim"
  ],
  "additionalProperties": false
}
