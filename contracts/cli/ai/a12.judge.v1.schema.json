{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/ai/a12.judge.v1.schema.json",
  "title": "A12 judge",
  "description": "Eval judge verdict, one judge per failure mode (Bureau §7.1 A12).",
  "type": "object",
  "properties": {
    "pass": {
      "type": "boolean"
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  },
  "required": ["pass", "reason_code"],
  "additionalProperties": false
}
