{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/ai/a5.condense.v1.schema.json",
  "title": "A5 condense",
  "description": "Extractive, digit-free condensation of long source text (Bureau §7.1 A5).",
  "type": "object",
  "properties": {
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "pattern": "^[^0-9]*$",
            "maxLength": 200
          },
          "support": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 1
          }
        },
        "required": ["text", "support"],
        "additionalProperties": false
      },
      "maxItems": 12
    },
    "quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "block": {
            "type": "integer"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["block", "start", "end"],
        "additionalProperties": false
      }
    }
  },
  "required": ["points", "quotes"],
  "additionalProperties": false
}
