{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/standing.show.schema.json",
  "title": "news standing show",
  "description": "Current settings with their defaults, or those under a key prefix. Runs in this process against PostgreSQL through the function the Hotline handler calls, so the data is the Hotline command's output (ADR 0008 §11).",
  "x-news-tier": "R",
  "x-news-status": "built",
  "x-news-errors": ["precondition", "upstream_unavailable"],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "A key or key prefix"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "output": {
      "$ref": "../../hotline/commands/standing.get.schema.json#/$defs/output"
    }
  }
}
