{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/jobs.complete.schema.json",
  "title": "news jobs complete",
  "description": "Mark a running job completed with its result. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "W",
  "x-news-status": "built",
  "x-news-errors": [
    "not_found",
    "conflict",
    "validation_failed"
  ],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "job": {
          "type": "integer"
        },
        "result": {
          "type": "string",
          "description": "JSON file, or - for stdin"
        },
        "worker": {
          "type": "string"
        }
      },
      "required": [
        "job",
        "result"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "integer"
        },
        "state": {
          "const": "completed"
        }
      },
      "required": [
        "job_id",
        "state"
      ],
      "additionalProperties": false
    }
  }
}
