{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/jobs.claim.schema.json",
  "title": "news jobs claim",
  "description": "Claim ready jobs from a pool; --limit sets how many (default 1). Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "W",
  "x-news-status": "built",
  "x-news-errors": ["usage", "not_found", "precondition"],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "pool": {
          "enum": ["net", "cpu", "docling", "render", "ai", "publish"]
        },
        "worker": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "lease_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["pool", "worker"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "job_id": {
                "type": "integer"
              },
              "kind": {
                "type": "string"
              },
              "pool": {
                "type": "string"
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "run_id": {
                "type": ["string", "null"],
                "format": "uuid"
              },
              "item_ref": {
                "type": ["string", "null"]
              },
              "args": {
                "type": "object"
              },
              "input_path": {
                "description": "args.input_path when the enqueuing step wrote an input file"
              },
              "lease_until": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "job_id",
              "kind",
              "pool",
              "attempt",
              "run_id",
              "item_ref",
              "args",
              "input_path",
              "lease_until"
            ],
            "additionalProperties": false
          }
        },
        "pool": {
          "type": "string"
        },
        "paused_until": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Set when the pool is paused; nothing was claimed"
        },
        "next_cursor": {
          "type": "string",
          "description": "Present when truncated: pass to --cursor"
        }
      },
      "required": ["items", "pool", "paused_until"],
      "additionalProperties": false
    }
  }
}
