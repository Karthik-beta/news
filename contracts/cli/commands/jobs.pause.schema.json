{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/jobs.pause.schema.json",
  "title": "news jobs pause",
  "description": "Pause a pool until a time. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "H",
  "x-news-status": "built",
  "x-news-errors": ["usage", "not_found", "gated"],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "pool": {
          "enum": ["net", "cpu", "docling", "render", "ai", "publish"]
        },
        "until": {
          "type": "string",
          "description": "RFC 3339, or +30m, +2h, +1d"
        }
      },
      "required": ["pool", "until"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "pool": {
          "type": "string"
        },
        "paused_until": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["pool", "paused_until"],
      "additionalProperties": false
    }
  }
}
