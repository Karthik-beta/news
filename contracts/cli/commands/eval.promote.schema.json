{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/eval.promote.schema.json",
  "title": "news eval promote",
  "description": "Promote a prompt version. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "G",
  "x-news-status": "stub until #19",
  "x-news-errors": [
    "gated"
  ],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "step": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        }
      },
      "required": [
        "step",
        "prompt_version"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "step": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "promoted": {
          "type": "boolean"
        }
      },
      "required": [
        "step",
        "prompt_version",
        "promoted"
      ],
      "additionalProperties": false
    }
  }
}
