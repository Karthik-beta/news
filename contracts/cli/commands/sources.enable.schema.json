{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/sources.enable.schema.json",
  "title": "news sources enable",
  "description": "Enable a source. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "G",
  "x-news-status": "stub until #9",
  "x-news-errors": [
    "not_found",
    "gated"
  ],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "enabled"
      ],
      "additionalProperties": false
    }
  }
}
