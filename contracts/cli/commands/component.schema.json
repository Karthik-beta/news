      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "summary": {},
        "props": {
          "type": "object"
        },
        "data_shape": {},
        "example": {}
      },
      "required": [
        "type",
        "summary",
        "props",
        "data_shape",
        "example"
      ],
      "additionalProperties": false
    }
  }
}
