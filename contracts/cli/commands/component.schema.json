{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/component.schema.json",
  "title": "news component",
  "description": "One component's props, data shape and example. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "R",
  "x-news-status": "built",
  "x-news-errors": [
    "not_found",
    "precondition"
  ],
  "$defs": {
