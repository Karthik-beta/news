{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/entities.alias.merge.schema.json",
  "title": "news entities alias merge",
  "description": "Merge one entity into another. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "H",
  "x-news-status": "stub until #12",
  "x-news-errors": [
    "not_found",
    "gated"
  ],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "into": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "into"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "into": {
          "type": "integer"
        },
        "merged_aliases": {
          "type": "integer"
        }
      },
      "required": [
        "into",
        "merged_aliases"
      ],
      "additionalProperties": false
    }
  }
}
