{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/sources.health.schema.json",
  "title": "news sources health",
  "description": "Source health with reasons, from fetch_state and snapshots. ratio_304 is the share of the source's URLs whose latest fetch falls in the window that got a 304: it counts URLs, not fetch events. error_classes is empty and quota_used is null: both live in ClickHouse and jobs. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "R",
  "x-news-status": "built",
  "x-news-errors": [],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "since": {
          "type": "string",
          "description": "for example 7d"
        }
      },
      "required": ["since"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string"
              },
              "health": {
                "enum": ["green", "amber", "red"]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ratio_304": {
                "type": "number"
              },
              "error_classes": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "last_success": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "quota_used": {
                "type": ["integer", "null"]
              }
            },
            "required": ["source_id", "health", "reasons", "ratio_304", "error_classes", "last_success", "quota_used"],
            "additionalProperties": false
          }
        },
        "next_cursor": {
          "type": "string",
          "description": "Present when truncated: pass to --cursor"
        }
      },
      "required": ["items"],
      "additionalProperties": false
    }
  }
}
