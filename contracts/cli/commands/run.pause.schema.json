{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/run.pause.schema.json",
  "title": "news run pause",
  "description": "Pause a run at the next step boundary. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "W",
  "x-news-status": "stub until #10",
  "x-news-errors": ["precondition"],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "run": {
          "type": "string",
          "description": "Run id or short id (r_…)"
        }
      },
      "required": ["run"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "pausing": {
          "type": "boolean"
        },
        "after_step": {
          "type": ["string", "null"]
        }
      },
      "required": ["pausing", "after_step"],
      "additionalProperties": false
    }
  }
}
