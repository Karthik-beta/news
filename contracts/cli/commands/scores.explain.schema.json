{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/scores.explain.schema.json",
  "title": "news scores explain",
  "description": "A story's score card (the Pitch). Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "R",
  "x-news-status": "stub until #15",
  "x-news-errors": [
    "not_found"
  ],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "story": {
          "type": "string"
        }
      },
      "required": [
        "story"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "story_id": {
          "type": "integer"
        },
        "total": {
          "type": "number"
        },
        "components": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "explain": {
          "type": "string"
        }
      },
      "required": [
        "story_id",
        "total",
        "components",
        "explain"
      ],
      "additionalProperties": false
    }
  }
}
