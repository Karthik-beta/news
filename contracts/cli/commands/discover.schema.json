{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/discover.schema.json",
  "title": "news discover",
  "description": "Run source connectors; store new candidates. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "W",
  "x-news-status": "stub until #9",
  "x-news-errors": [
    "upstream_unavailable"
  ],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "new_candidates": {
          "type": "integer"
        },
        "by_source": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      },
      "required": [
        "new_candidates",
        "by_source"
      ],
      "additionalProperties": false
    }
  }
}
