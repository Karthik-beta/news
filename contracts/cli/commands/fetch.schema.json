{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/fetch.schema.json",
  "title": "news fetch",
  "description": "Download a story's source files and API data. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "W",
  "x-news-status": "stub until #9",
  "x-news-errors": ["rate_limited", "validation_failed", "not_found"],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "story": {
          "type": "string"
        }
      },
      "required": ["story"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "snapshots": {
          "type": "integer"
        },
        "data_points": {
          "type": "integer"
        }
      },
      "required": ["status", "snapshots", "data_points"],
      "additionalProperties": false
    }
  }
}
