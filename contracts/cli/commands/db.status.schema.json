{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/db.status.schema.json",
  "title": "news db status",
  "description": "Applied and pending migrations. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "R",
  "x-news-status": "built",
  "x-news-errors": [
    "precondition",
    "upstream_unavailable"
  ],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string"
        },
        "applied": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "pending": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "up_to_date": {
          "type": "boolean"
        }
      },
      "required": [
        "schema",
        "applied",
        "pending",
        "up_to_date"
      ],
      "additionalProperties": false
    }
  }
}
