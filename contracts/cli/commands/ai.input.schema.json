{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/ai.input.schema.json",
  "title": "news ai input",
  "description": "Path of a job's input file. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "W",
  "x-news-status": "built",
  "x-news-errors": ["not_found", "precondition"],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "job": {
          "type": "integer"
        }
      },
      "required": ["job"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "required": ["path"],
      "additionalProperties": false
    }
  }
}
