{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/db.migrate.schema.json",
  "title": "news db migrate",
  "description": "Apply pending migrations; idempotent. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "W",
  "x-news-status": "built",
  "x-news-errors": ["precondition", "upstream_unavailable", "internal"],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string"
        },
        "applied": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "current": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "ai_max_running": {
          "type": ["integer", "null"]
        }
      },
      "required": ["schema", "applied", "current", "ai_max_running"],
      "additionalProperties": false
    }
  }
}
