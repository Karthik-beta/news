{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/related.schema.json",
  "title": "news related",
  "description": "Up to 10 related pages and entities. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "R",
  "x-news-status": "built",
  "x-news-errors": [],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "story": {
          "type": "string"
        }
      },
      "required": ["story"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": ["page", "entity"]
              },
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": ["kind", "id", "title"],
            "additionalProperties": false
          }
        },
        "next_cursor": {
          "type": "string",
          "description": "Present when truncated: pass to --cursor"
        }
      },
      "required": ["items"],
      "additionalProperties": false
    }
  }
}
