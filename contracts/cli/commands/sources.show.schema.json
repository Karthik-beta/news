{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/sources.show.schema.json",
  "title": "news sources show",
  "description": "One source. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "R",
  "x-news-status": "stub until #9",
  "x-news-errors": ["not_found"],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        }
      },
      "required": ["source"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "source_tier": {
          "type": "integer"
        },
        "licence": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "health": {
          "enum": ["unknown", "green", "amber", "red"]
        }
      },
      "required": ["source_id", "name", "publisher", "source_tier", "licence", "enabled", "health"],
      "additionalProperties": true
    }
  }
}
