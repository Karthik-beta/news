{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/run.presets.schema.json",
  "title": "news run presets",
  "description": "The preset catalogue. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "R",
  "x-news-status": "stub until #10",
  "x-news-errors": [],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "grammar": {
                "type": "string"
              },
              "heavy": {
                "type": "boolean"
              },
              "writes": {
                "type": "boolean"
              },
              "publishes": {
                "type": "boolean"
              },
              "gates": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reference": {
                "type": "string"
              }
            },
            "required": ["id", "name", "grammar", "heavy", "writes", "publishes", "gates", "reference"],
            "additionalProperties": false
          }
        },
        "next_cursor": {
          "type": "string",
          "description": "Present when truncated: pass to --cursor"
        }
      },
      "required": ["items"],
      "additionalProperties": false
    }
  }
}
