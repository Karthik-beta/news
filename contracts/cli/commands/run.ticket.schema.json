{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/run.ticket.schema.json",
  "title": "news run ticket",
  "description": "Issue a start ticket from a terminal. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "H",
  "x-news-status": "stub until #10",
  "x-news-errors": ["usage", "gated"],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "preset": {
          "type": "string"
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": ["preset"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "ticket_id": {
          "type": "integer"
        },
        "canonical": {
          "type": "string"
        }
      },
      "required": ["ticket_id", "canonical"],
      "additionalProperties": false
    }
  }
}
