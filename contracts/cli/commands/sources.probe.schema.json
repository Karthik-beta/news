{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/sources.probe.schema.json",
  "title": "news sources probe",
  "description": "One live discovery call, no writes. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "R",
  "x-news-status": "stub until #9",
  "x-news-errors": [
    "not_found",
    "upstream_unavailable",
    "rate_limited",
    "licence_blocked"
  ],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "refs": {
          "type": "integer"
        },
        "sample": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 5
        }
      },
      "required": [
        "refs",
        "sample"
      ],
      "additionalProperties": false
    }
  }
}
