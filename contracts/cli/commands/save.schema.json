{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/save.schema.json",
  "title": "news save",
  "description": "Store a Copy (page-draft.v1) for a story. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "W",
  "x-news-status": "stub until #17",
  "x-news-errors": ["validation_failed", "not_found"],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "story": {
          "type": "string"
        },
        "file": {
          "type": "string"
        }
      },
      "required": ["story", "file"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "draft_id": {
          "type": "string"
        }
      },
      "required": ["draft_id"],
      "additionalProperties": false
    }
  }
}
