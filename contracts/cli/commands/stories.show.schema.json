{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://news.karthik.nz/contracts/cli/commands/stories.show.schema.json",
  "title": "news stories show",
  "description": "One story. Input is the command's arguments as an object; output is the envelope's data.",
  "x-news-tier": "R",
  "x-news-status": "stub until #15",
  "x-news-errors": ["not_found"],
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "story": {
          "type": "string"
        }
      },
      "required": ["story"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "story_id": {
          "type": "integer"
        },
        "event_key": {
          "type": ["string", "null"]
        },
        "title": {
          "type": ["string", "null"]
        },
        "member_count": {
          "type": "integer"
        },
        "status": {
          "enum": ["open", "covered", "closed"]
        },
        "page_id": {
          "type": ["string", "null"]
        }
      },
      "required": ["story_id", "event_key", "title", "member_count", "status", "page_id"],
      "additionalProperties": false
    }
  }
}
