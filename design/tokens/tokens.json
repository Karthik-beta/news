{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "News design tokens, Direction E. Source of truth; tokens.css is generated from this file by build.mjs. Mode-dependent colours carry their dark value in $extensions[\"news.dark\"].",
  "color": {
    "$type": "color",
    "paper": { "$value": "#F4F4F1", "$extensions": { "news.dark": "#17181A" }, "$description": "Page background" },
    "wash": {
      "$value": "#E9E9E4",
      "$extensions": { "news.dark": "#222428" },
      "$description": "Note blocks, footer, table row hover"
    },
    "rule": {
      "$value": "#DADAD4",
      "$extensions": { "news.dark": "#313337" },
      "$description": "Hairline rules, gridlines, input borders at rest"
    },
    "ink": {
      "$value": "#181818",
      "$extensions": { "news.dark": "#EDEDEA" },
      "$description": "Primary text, headlines, figures, ink rules"
    },
    "ink-2": {
      "$value": "#555551",
      "$extensions": { "news.dark": "#B4B4B0" },
      "$description": "Secondary text: summaries, subtitles, labels"
    },
    "ink-3": {
      "$value": "#656561",
      "$extensions": { "news.dark": "#9C9C97" },
      "$description": "Tertiary text: source lines, meta, axis ticks"
    },
    "brand": {
      "$value": "#C8213A",
      "$extensions": { "news.dark": "#F4687C" },
      "$description": "Crimson. Wordmark, fly titles, chart rule and tag, highlighted data, current-nav underline. Never means 'down'."
    },
    "on-brand": {
      "$value": "#FFFFFF",
      "$extensions": { "news.dark": "#17181A" },
      "$description": "Text on a crimson fill (rare)"
    },
    "control-border": {
      "$value": "#8A8A85",
      "$extensions": { "news.dark": "#6E6F73" },
      "$description": "Borders of inputs, selects and buttons (>= 3:1 on paper)"
    },
    "focus": { "$value": "#065DA0", "$extensions": { "news.dark": "#8FC0EA" }, "$description": "Focus ring" },
    "selection": {
      "$value": "#D9EAFC",
      "$extensions": { "news.dark": "#085491" },
      "$description": "Text selection background"
    },
    "error": {
      "$value": "#C8213A",
      "$extensions": { "news.dark": "#F4687C" },
      "$description": "Form errors only, always with an icon and text"
    }
  },
  "chart": {
    "$type": "color",
    "highlight": {
      "$value": "#C8213A",
      "$extensions": { "news.dark": "#F4687C" },
      "$description": "The one series, bar or value the title is about"
    },
    "comparison": {
      "$value": "#065DA0",
      "$extensions": { "news.dark": "#4E90D2" },
      "$description": "A single named comparison series beside the highlight"
    },
    "context": {
      "$value": "#8DAECB",
      "$extensions": { "news.dark": "#45556A" },
      "$description": "Everything else in a highlight chart; recessive by design"
    },
    "neutral": {
      "$value": "#B6B6AF",
      "$extensions": { "news.dark": "#4C4E53" },
      "$description": "Deductions in waterfalls, 'Other', missing-data hatching"
    },
    "grid": { "$value": "#DADAD4", "$extensions": { "news.dark": "#313337" }, "$description": "Gridlines" },
    "baseline": {
      "$value": "#181818",
      "$extensions": { "news.dark": "#EDEDEA" },
      "$description": "Zero line and x-axis baseline"
    },
    "cat": {
      "$description": "Categorical slots, fixed order, validated for CVD (adjacent pairs) and all-pairs for the first three. Never cycled; a ninth series folds into Other.",
      "1": { "$value": "#065DA0", "$extensions": { "news.dark": "#2470B4" }, "$description": "Blue" },
      "2": { "$value": "#A14F09", "$extensions": { "news.dark": "#B3622A" }, "$description": "Rust" },
      "3": { "$value": "#05A4D4", "$extensions": { "news.dark": "#0BA5C0" }, "$description": "Sky" },
      "4": { "$value": "#006E30", "$extensions": { "news.dark": "#1B763A" }, "$description": "Green" },
      "5": { "$value": "#8463B8", "$extensions": { "news.dark": "#8667B9" }, "$description": "Violet" },
      "6": { "$value": "#718109", "$extensions": { "news.dark": "#74841B" }, "$description": "Olive" },
      "7": { "$value": "#8B376B", "$extensions": { "news.dark": "#A83E83" }, "$description": "Plum" },
      "8": { "$value": "#CD9C34", "$extensions": { "news.dark": "#A17924" }, "$description": "Gold" }
    },
    "seq-blue": {
      "$description": "Sequential (magnitude), one hue. Light mode: 100 = near zero. Dark mode reverses the anchor: 700 = near zero.",
      "100": { "$value": "#D9EAFC" },
      "200": { "$value": "#AECEF1" },
      "300": { "$value": "#7FAFE2" },
      "400": { "$value": "#4E90D2" },
      "500": { "$value": "#2672B7" },
      "600": { "$value": "#085491" },
      "700": { "$value": "#003967" }
    },
    "seq-gold": {
      "$description": "Second sequential hue, only when two magnitude scales appear together; also the warm arm of the diverging scale.",
      "100": { "$value": "#F4E6CE" },
      "200": { "$value": "#E3C697" },
      "300": { "$value": "#CCA45E" },
      "400": { "$value": "#B28324" },
      "500": { "$value": "#906600" },
      "600": { "$value": "#6C4C02" },
      "700": { "$value": "#4B3301" }
    },
    "div-mid": {
      "$value": "#E4E4DF",
      "$extensions": { "news.dark": "#3A3C40" },
      "$description": "Diverging midpoint (blue arm <-> gold arm). Never crimson."
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "serif": { "$value": ["Literata", "Georgia", "Times New Roman", "serif"] },
      "sans": { "$value": ["Fira Sans", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "headline-s": { "$value": 650 },
      "bold": { "$value": 700 },
      "wordmark": { "$value": 800 }
    },
    "size": {
      "$type": "dimension",
      "source": { "$value": { "value": 0.78125, "unit": "rem" }, "$description": "12.5px" },
      "label": { "$value": { "value": 0.84375, "unit": "rem" }, "$description": "13.5px" },
      "chart-subtitle": { "$value": { "value": 0.90625, "unit": "rem" }, "$description": "14.5px" },
      "ui": { "$value": { "value": 0.9375, "unit": "rem" }, "$description": "15px; also fly titles" },
      "body-s": { "$value": { "value": 0.96875, "unit": "rem" }, "$description": "15.5px" },
      "body": { "$value": { "value": 1.09375, "unit": "rem" }, "$description": "17.5px (17px on phone)" },
      "chart-title": { "$value": { "value": 1.125, "unit": "rem" }, "$description": "18px" },
      "headline-s": { "$value": { "value": 1.15625, "unit": "rem" }, "$description": "18.5px" },
      "standfirst": { "$value": { "value": 1.25, "unit": "rem" }, "$description": "20px (18px on phone)" },
      "headline-m": { "$value": { "value": 1.3125, "unit": "rem" }, "$description": "21px" },
      "headline-l": { "$value": { "value": 1.4375, "unit": "rem" }, "$description": "23px" },
      "figure-s": { "$value": { "value": 1.5, "unit": "rem" }, "$description": "24px" },
      "figure": { "$value": { "value": 1.75, "unit": "rem" }, "$description": "28px (24px on phone)" },
      "wordmark": { "$value": { "value": 1.875, "unit": "rem" }, "$description": "30px (26px on phone)" }
    },
    "fluid": {
      "$description": "CSS clamp() expressions for fluid sizes",
      "display": { "$type": "string", "$value": "clamp(1.75rem, 1.2rem + 2.2vw, 2.5rem)" },
      "headline-xl": { "$type": "string", "$value": "clamp(1.875rem, 1.2rem + 2.6vw, 2.75rem)" }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.08 },
      "display": { "$value": 1.1 },
      "headline": { "$value": 1.2 },
      "heading": { "$value": 1.25 },
      "ui": { "$value": 1.45 },
      "standfirst": { "$value": 1.45 },
      "summary": { "$value": 1.5 },
      "body": { "$value": 1.65 }
    },
    "tracking": {
      "$type": "dimension",
      "headline-xl": { "$value": { "value": -0.018, "unit": "em" } },
      "display": { "$value": { "value": -0.015, "unit": "em" } },
      "wordmark": { "$value": { "value": -0.015, "unit": "em" } }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 2, "unit": "px" } },
    "2": { "$value": { "value": 4, "unit": "px" } },
    "3": { "$value": { "value": 8, "unit": "px" } },
    "4": { "$value": { "value": 12, "unit": "px" } },
    "5": { "$value": { "value": 16, "unit": "px" } },
    "6": { "$value": { "value": 20, "unit": "px" } },
    "7": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 28, "unit": "px" } },
    "9": { "$value": { "value": 32, "unit": "px" } },
    "10": { "$value": { "value": 40, "unit": "px" } },
    "11": { "$value": { "value": 56, "unit": "px" } },
    "12": { "$value": { "value": 72, "unit": "px" } }
  },
  "layout": {
    "$type": "dimension",
    "container": { "$value": { "value": 1120, "unit": "px" } },
    "article": { "$value": { "value": 720, "unit": "px" } },
    "rail": { "$value": { "value": 250, "unit": "px" } },
    "prose": { "$value": { "value": 66, "unit": "ch" } },
    "gutter-phone": { "$value": { "value": 16, "unit": "px" } },
    "gutter-tablet": { "$value": { "value": 24, "unit": "px" } },
    "gutter-desktop": { "$value": { "value": 32, "unit": "px" } },
    "bp-tablet": { "$value": { "value": 600, "unit": "px" } },
    "bp-desktop": { "$value": { "value": 980, "unit": "px" } },
    "bp-wide": { "$value": { "value": 1120, "unit": "px" } }
  },
  "border": {
    "$type": "dimension",
    "hairline": { "$value": { "value": 1, "unit": "px" } },
    "section": { "$value": { "value": 2, "unit": "px" } },
    "chart-tag-width": { "$value": { "value": 36, "unit": "px" } },
    "chart-tag-height": { "$value": { "value": 7, "unit": "px" } },
    "focus": { "$value": { "value": 2, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": { "value": 0, "unit": "px" }, "$description": "Content: charts, notes, images, tables" },
    "chip": { "$value": { "value": 3, "unit": "px" }, "$description": "Badges, chips" },
    "control": { "$value": { "value": 5, "unit": "px" }, "$description": "Buttons, inputs" }
  },
  "chart-mark": {
    "$type": "dimension",
    "line-width": { "$value": { "value": 2.5, "unit": "px" } },
    "line-width-context": { "$value": { "value": 1.5, "unit": "px" } },
    "marker": { "$value": { "value": 8, "unit": "px" } },
    "bar-gap": { "$value": { "value": 2, "unit": "px" }, "$description": "Surface gap between adjacent fills" },
    "bar-thickness-h": { "$value": { "value": 22, "unit": "px" }, "$description": "Horizontal bar height" }
  },
  "motion": {
    "$type": "duration",
    "fast": { "$value": { "value": 120, "unit": "ms" } },
    "base": { "$value": { "value": 200, "unit": "ms" } }
  }
}
